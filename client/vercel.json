{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://password-locker-backend-pi.vercel.app/api/$1" },
    { "source": "/((?!sw\\.js|workbox-.*\\.js|manifest\\.webmanifest|icons/.*).*)", "destination": "/index.html" }
  ]
}